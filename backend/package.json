{
  "name": "resumeiq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ResumeIQ REST API — Node.js 24, Express, TypeScript, Oracle Database",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "catalogue:generate": "tsx scripts/generate-ats-template-catalogue.ts",
    "catalogue:check": "tsx scripts/generate-ats-template-catalogue.ts --check",
    "verify:pdf": "tsx scripts/pdf-content-verification.ts",
    "matrix:pdf": "tsx scripts/pdf-export-matrix.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "oracledb": "^6.7.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "playwright-core": "^1.62.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/oracledb": "^7.0.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.17.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "oracledb@6.10.0": true,
    "esbuild@0.28.1": true
  }
}
