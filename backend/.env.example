# ResumeIQ backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Optional: request body size limit in bytes (default 1mb)
BODY_LIMIT=1mb

# --- Data store ---
# Which adapter backs the repositories:
#   memory  - in-memory (tests, throwaway dev)
#   file    - dev-only JSON-file persistence (restart survivors without Oracle)
#   oracle  - real Oracle Database (requires ORACLE_* below)
# Unset: defaults to `oracle` when ORACLE_* are present, otherwise `memory`.
DATA_STORE=file
# Path used by DATA_STORE=file (default data/resumeiq-store.json)
FILE_STORE_PATH=data/resumeiq-store.json

# --- Oracle Database (node-oracledb Thin mode) ---
# Connect string formats:
#   localhost:1521/FREEPDB1       (service name, PDB)
#   host:port/SERVICE_NAME
#   host:port/SID as HOST:PORT/SID
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# --- Authentication ---
# Secret used to sign access tokens. Must be >= 16 chars; REQUIRED in production.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 900)
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default 30)
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Name of the httpOnly refresh cookie (default refresh_token)
AUTH_COOKIE_NAME=refresh_token
# Set Secure on the refresh cookie for HTTPS (defaults to true in production,
# false in development so the browser accepts it over http).
AUTH_COOKIE_SECURE=false

# --- Transactional email ---
# capture is for local development/test only and is rejected in production.
EMAIL_PROVIDER=capture
RESEND_API_KEY=
EMAIL_FROM_NAME=ResumeIQ
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
PUBLIC_APP_URL=http://127.0.0.1:4201
# Bounded provider request timeout (1000-30000ms; default 8000).
EMAIL_REQUEST_TIMEOUT_MS=8000
# Rate limits (per window; default window is 15 minutes)
AUTH_RATE_LIMIT_LOGIN_MAX=100
AUTH_RATE_LIMIT_REGISTER_MAX=20
AUTH_RATE_LIMIT_REFRESH_MAX=200

# --- Logging ---
LOG_LEVEL=info

# --- PDF export (headless Chromium) ---
# Generation timeout in milliseconds (default 60000)
PDF_GENERATION_TIMEOUT_MS=60000
# Maximum accepted HTML payload size in bytes (default 2097152)
PDF_MAX_HTML_BYTES=2097152
