# ResumeIQ Oracle provisioning — copy to `.env` and fill in real values.
# NEVER commit `.env` (see database/.gitignore).
#
# Password constraints enforced by the migration runner:
#   8-60 characters, no whitespace, and none of:  " @ / & % ` ' ( ) ;
#
# Usernames are unquoted Oracle identifiers: [A-Za-z][A-Za-z0-9_$#]{0,29}.

# SYS/SYSTEM superuser password. Used by compose at first container start and
# by the runner ONLY for the one-time `--bootstrap` step (user creation). The
# normal migration/grant-sync/reset/status commands need no SYSTEM credentials.
ORACLE_SYSTEM_USER=SYSTEM
ORACLE_SYSTEM_PASSWORD=

# Schema owner ("migration user"). Owns the tables, triggers and indexes
# created by migrations; used by the runner for DDL and grant-sync.
ORACLE_MIGRATE_USER=RIQ_MIGRATE
ORACLE_MIGRATE_PASSWORD=

# Least-privileged runtime user. The backend connects as this user; it only
# has SELECT/INSERT/UPDATE/DELETE on the owner's tables (direct grants, no
# synonyms). The backend sets CURRENT_SCHEMA to ORACLE_OWNER_SCHEMA on every
# pooled session so its unqualified table names resolve to the owner's schema.
ORACLE_USER=RIQ_APP
ORACLE_PASSWORD=

# Schema that owns the tables (the migration user). The backend validates this
# as an unquoted Oracle identifier and uses it for CURRENT_SCHEMA.
ORACLE_OWNER_SCHEMA=RIQ_MIGRATE

# PDB service name on the local container.
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
